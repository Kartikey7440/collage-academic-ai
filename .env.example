# College AI Agent — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

DATABASE_URL=postgresql+asyncpg://college_ai:college_ai_secret@localhost:5432/college_ai
TEST_DATABASE_URL=postgresql+asyncpg://college_ai:college_ai_secret@localhost:5432/test_college_ai

# Phase 3 — JWT Auth
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-real-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Timezone — all "now" calculations in the API use this IANA timezone.
# Docker containers default to UTC; set this explicitly for your deployment region.
# Default: Asia/Kolkata (IST, UTC+5:30)
COLLEGE_TIMEZONE=Asia/Kolkata

# Optional: Anthropic API key (needed for Phase 1 live vision extraction)
# ANTHROPIC_API_KEY=your_api_key_here
